<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Enable_Target_CopyDebugJsonToSettingsOutput>true</Enable_Target_CopyDebugJsonToSettingsOutput>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="log4net" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="ZYC.CoreToolkit.Extensions.Autofac" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ZYC.Framework.Modules.Log.Abstractions\ZYC.Framework.Modules.Log.Abstractions.csproj" />
    <ProjectReference Include="..\ZYC.Framework.Core\ZYC.Framework.Core.csproj" />
    <ProjectReference Include="..\ZYC.Framework.Modules.ModuleManager.Abstractions\ZYC.Framework.Modules.ModuleManager.Abstractions.csproj" />
  </ItemGroup>


  <ItemGroup>
    <LogConfigFiles Include="log4net.config" />
  </ItemGroup>

  <Target Name="CopyLogConfigToSettingsOutput"
          AfterTargets="Build">
    <Copy SourceFiles="@(LogConfigFiles)"
          DestinationFiles="@(LogConfigFiles->'$(SettingsOutputDir)\%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>