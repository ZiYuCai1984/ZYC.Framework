<Project>

  <Target Name="Copy_ZYC_Framework_Alpha_Files" BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <ZYC_Framework_Alpha_Files Include="$(MSBuildThisFileDirectory)..\**\*" />
    </ItemGroup>

    <Copy SourceFiles="@(ZYC_Framework_Alpha_Files)" DestinationFolder="$(OutputPath)\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)..\SharedSources\**\*.cs"
             Link="ZYC.SharedSources\%(RecursiveDir)%(Filename)%(Extension)">
    </Compile>
  </ItemGroup>


</Project>