<UserControl x:Class="ZYC.Framework.Core.Page.NoItemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:bindings="clr-namespace:ZYC.Framework.Core.Bindings"
             mc:Ignorable="d"
             d:DesignHeight="450" 
             d:DesignWidth="800"
             x:Name="Root">
    <Grid VerticalAlignment="Center"
          HorizontalAlignment="Center">
        <TextBlock Text="{bindings:LBinding Text,ElementName=Root}"
                   FontSize="32"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource MahApps.Brushes.Validation4}" />
    </Grid>
</UserControl>
