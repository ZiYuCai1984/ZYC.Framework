<page:PageBase x:Class="ZYC.Framework.Modules.ModuleManager.UI.LocalModuleManagerView"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:page="clr-namespace:ZYC.Framework.Core.Page;assembly=ZYC.Framework.Core"
               xmlns:localizations="clr-namespace:ZYC.Framework.Core.Localizations;assembly=ZYC.Framework.Core"
               xmlns:converters="clr-namespace:ZYC.Framework.Core.Converters;assembly=ZYC.Framework.Core"
               xmlns:markupEx="clr-namespace:ZYC.Framework.Core.MarkupEx;assembly=ZYC.Framework.Core"
               xmlns:core="clr-namespace:ZYC.Framework.Core;assembly=ZYC.Framework.Core"
               xmlns:buttons="clr-namespace:ZYC.Framework.Core.Buttons;assembly=ZYC.Framework.Core"
               xmlns:commands="clr-namespace:ZYC.Framework.Modules.ModuleManager.Commands"
               xmlns:abstractions="clr-namespace:ZYC.Framework.Modules.ModuleManager.Abstractions;assembly=ZYC.Framework.Modules.ModuleManager.Abstractions"
               mc:Ignorable="d"
               d:DesignHeight="450" d:DesignWidth="800"
               Title="{localizations:L Local Modules}"
               DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <Grid>
        <core:SplitView Visibility="{Binding ModulesCount,Converter={converters:IntToVisibilityConverter}}"
                        Ratio="{Binding Source={markupEx:LifetimeScopeResolve abstractions:LocalModulePageState},Path=Ratio}">
            <core:SplitView.LeftContent>
                <Border Margin="0 8 0 0">
                    <ListBox BorderThickness="0"
                             ItemsSource="{Binding ModuleInfos}"
                             SelectedItem="{Binding SelectedModuleInfo,Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>

                                    <core:HybridIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        Width="24"
                                        Height="24"
                                        FontSize="16"
                                        Icon="{Binding Icon}" />

                                    <StackPanel Grid.Column="1"
                                                Margin="8 0 0 0">
                                        <TextBlock FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding ModuleAssemblyName}" />
                                        <TextBlock Margin="0 4 0 0"
                                                   Opacity="0.72"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding ModulePath}" />

                                        <TextBlock Margin="0 4 0 0"
                                                   Foreground="Red"
                                                   Text="Deleted">
                                            <TextBlock.Visibility>
                                                <MultiBinding
                                                    Converter="{converters:StringContainsToVisibilityMultiValueConverter}">
                                                    <Binding Path="ModulePendingDeleteAssemblyNames"
                                                             RelativeSource="{RelativeSource AncestorType=page:PageBase}" />
                                                    <Binding Path="ModuleAssemblyName" />
                                                </MultiBinding>
                                            </TextBlock.Visibility>
                                        </TextBlock>

                                        <Grid>
                                            <Grid.Visibility>
                                                <MultiBinding
                                                    Converter="{converters:StringContainsToVisibilityMultiValueConverter Reverse=True}">
                                                    <Binding Path="ModulePendingDeleteAssemblyNames"
                                                             RelativeSource="{RelativeSource AncestorType=page:PageBase}" />
                                                    <Binding Path="ModuleAssemblyName" />
                                                </MultiBinding>
                                            </Grid.Visibility>
                                            <TextBlock Foreground="Green"
                                                       Text="Enabled">
                                                <TextBlock.Visibility>
                                                    <MultiBinding
                                                        Converter="{converters:StringContainsToVisibilityMultiValueConverter Reverse=True}">
                                                        <Binding Path="ModuleDisabledAssemblyNames"
                                                                 RelativeSource="{RelativeSource AncestorType=page:PageBase}" />
                                                        <Binding Path="ModuleAssemblyName" />
                                                    </MultiBinding>
                                                </TextBlock.Visibility>
                                            </TextBlock>
                                            <TextBlock Foreground="Red"
                                                       Text="Disabled">
                                                <TextBlock.Visibility>
                                                    <MultiBinding
                                                        Converter="{converters:StringContainsToVisibilityMultiValueConverter}">
                                                        <Binding Path="ModuleDisabledAssemblyNames"
                                                                 RelativeSource="{RelativeSource AncestorType=page:PageBase}" />
                                                        <Binding Path="ModuleAssemblyName" />
                                                    </MultiBinding>
                                                </TextBlock.Visibility>
                                            </TextBlock>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </core:SplitView.LeftContent>

            <core:SplitView.RightContent>
                <Border Margin="0 8 0 0"
                        Padding="16 16 0 16">
                    <Grid>
                        <ContentControl Content="{Binding SelectedModuleInfo}"
                                        Visibility="{Binding SelectedModuleInfo,Converter={converters:NullToVisibilityConverter}}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>

                                        <DockPanel Margin="0 0 0 16">
                                            <StackPanel DockPanel.Dock="Right"
                                                        Orientation="Horizontal"
                                                        Margin="16 0 0 0"
                                                        VerticalAlignment="Center">
                                                <StackPanel.IsEnabled>
                                                    <MultiBinding
                                                        Converter="{converters:StringContainsToBoolMultiValueConverter Reverse=True}">
                                                        <Binding Path="ModulePendingDeleteAssemblyNames"
                                                                 RelativeSource="{RelativeSource AncestorType=page:PageBase}" />
                                                        <Binding Path="ModuleAssemblyName" />
                                                    </MultiBinding>
                                                </StackPanel.IsEnabled>
                                                <buttons:IconButton Text="Enable"
                                                                    Kind="Check"
                                                                    Command="{markupEx:LifetimeScopeResolve commands:EnableModuleCommand}"
                                                                    CommandParameter="{Binding .}" />
                                                <buttons:IconButton Text="Disable"
                                                                    Kind="Cancel"
                                                                    Margin="8 0 0 0"
                                                                    Command="{markupEx:LifetimeScopeResolve commands:DisableModuleCommand}"
                                                                    CommandParameter="{Binding .}" />
                                                <buttons:IconButton Text="Delete"
                                                                    Kind="TrashCanOutline"
                                                                    Margin="8 0 0 0"
                                                                    Command="{markupEx:LifetimeScopeResolve commands:DeleteModuleCommand}"
                                                                    CommandParameter="{Binding .}" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal">
                                                <core:HybridIcon
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Top"
                                                    Width="32"
                                                    Height="32"
                                                    FontSize="20"
                                                    Icon="{Binding Icon}" />
                                                <StackPanel Margin="12 0 0 0">
                                                    <TextBlock FontSize="16"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               Text="{Binding ModuleAssemblyName}" />
                                                    <Grid Margin="0 4 0 0">
                                                        <TextBlock Foreground="Red"
                                                                   Text="Deleted">
                                                            <TextBlock.Visibility>
                                                                <MultiBinding
                                                                    Converter="{converters:StringContainsToVisibilityMultiValueConverter}">
                                                                    <Binding Path="ModulePendingDeleteAssemblyNames"
                                                                             RelativeSource="{RelativeSource AncestorType=page:PageBase}" />
                                                                    <Binding Path="ModuleAssemblyName" />
                                                                </MultiBinding>
                                                            </TextBlock.Visibility>
                                                        </TextBlock>
                                                        <Grid>
                                                            <Grid.Visibility>
                                                                <MultiBinding
                                                                    Converter="{converters:StringContainsToVisibilityMultiValueConverter Reverse=True}">
                                                                    <Binding Path="ModulePendingDeleteAssemblyNames"
                                                                             RelativeSource="{RelativeSource AncestorType=page:PageBase}" />
                                                                    <Binding Path="ModuleAssemblyName" />
                                                                </MultiBinding>
                                                            </Grid.Visibility>
                                                            <TextBlock Foreground="Green"
                                                                       Text="Enabled">
                                                                <TextBlock.Visibility>
                                                                    <MultiBinding
                                                                        Converter="{converters:StringContainsToVisibilityMultiValueConverter Reverse=True}">
                                                                        <Binding Path="ModuleDisabledAssemblyNames"
                                                                                 RelativeSource="{RelativeSource AncestorType=page:PageBase}" />
                                                                        <Binding Path="ModuleAssemblyName" />
                                                                    </MultiBinding>
                                                                </TextBlock.Visibility>
                                                            </TextBlock>
                                                            <TextBlock Foreground="Red"
                                                                       Text="Disabled">
                                                                <TextBlock.Visibility>
                                                                    <MultiBinding
                                                                        Converter="{converters:StringContainsToVisibilityMultiValueConverter}">
                                                                        <Binding Path="ModuleDisabledAssemblyNames"
                                                                                 RelativeSource="{RelativeSource AncestorType=page:PageBase}" />
                                                                        <Binding Path="ModuleAssemblyName" />
                                                                    </MultiBinding>
                                                                </TextBlock.Visibility>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </DockPanel>

                                        <Separator Grid.Row="1" />

                                        <ScrollViewer Grid.Row="2"
                                                      Margin="0 16 0 0"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      VerticalScrollBarVisibility="Auto">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold"
                                                           Text="Module" />
                                                <TextBlock Margin="16 4 0 12">
                                                    <Run Text="Assembly" />
                                                    <Run Text=" : " />
                                                    <Run Text="{Binding ModuleAssemblyName,Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Margin="16 0 0 12"
                                                           TextWrapping="Wrap">
                                                    <Run Text="Path" />
                                                    <Run Text=" : " />
                                                    <Run Text="{Binding ModulePath,Mode=OneWay}" />
                                                </TextBlock>

                                                <TextBlock Margin="0 8 0 4"
                                                           FontWeight="SemiBold"
                                                           Text="Reference Assemblies" />
                                                <TextBlock Text="No Item"
                                                           Margin="16 0 0 12"
                                                           Visibility="{Binding ReferenceAssemblyNames.Length,Converter={converters:IntToVisibilityConverter Reverse=True},FallbackValue=Collapsed}" />
                                                <ItemsControl ItemsSource="{Binding ReferenceAssemblyNames}"
                                                              Margin="16 0 0 12">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding .}"
                                                                       Margin="0 0 0 4" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <TextBlock Margin="0 8 0 4"
                                                           FontWeight="SemiBold"
                                                           Text="Dependence on" />
                                                <TextBlock Text="No Item"
                                                           Margin="16 0 0 12"
                                                           Visibility="{Binding DependencyOn.Length,Converter={converters:IntToVisibilityConverter Reverse=True},FallbackValue=Collapsed}" />
                                                <ItemsControl ItemsSource="{Binding DependencyOn}"
                                                              Margin="16 0 0 12">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding ModuleAssemblyName}"
                                                                       Margin="0 0 0 4" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <TextBlock Margin="0 8 0 4"
                                                           FontWeight="SemiBold"
                                                           Text="Dependence by" />
                                                <TextBlock Text="No Item"
                                                           Margin="16 0 0 12"
                                                           Visibility="{Binding DependencyBy.Length,Converter={converters:IntToVisibilityConverter Reverse=True},FallbackValue=Collapsed}" />
                                                <ItemsControl ItemsSource="{Binding DependencyBy}"
                                                              Margin="16 0 0 12">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding ModuleAssemblyName}"
                                                                       Margin="0 0 0 4" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Grid>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>

                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Opacity="0.72"
                                   Text="Select a local module"
                                   Visibility="{Binding SelectedModuleInfo,Converter={converters:NullToVisibilityConverter Reverse=True}}" />
                    </Grid>
                </Border>
            </core:SplitView.RightContent>
        </core:SplitView>

        <page:NoItemView
            Visibility="{Binding ModulesCount,Converter={converters:IntToVisibilityConverter Reverse=True}}" />
    </Grid>
</page:PageBase>
