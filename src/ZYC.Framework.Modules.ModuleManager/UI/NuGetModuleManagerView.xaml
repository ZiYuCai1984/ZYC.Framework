<page:PageBase x:Class="ZYC.Framework.Modules.ModuleManager.UI.NuGetModuleManagerView"
               x:ClassModifier="internal"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:page="clr-namespace:ZYC.Framework.Core.Page;assembly=ZYC.Framework.Core"
               xmlns:localizations="clr-namespace:ZYC.Framework.Core.Localizations;assembly=ZYC.Framework.Core"
               xmlns:converters="clr-namespace:ZYC.Framework.Core.Converters;assembly=ZYC.Framework.Core"
               xmlns:markupEx="clr-namespace:ZYC.Framework.Core.MarkupEx;assembly=ZYC.Framework.Core"
               xmlns:buttons="clr-namespace:ZYC.Framework.Core.Buttons;assembly=ZYC.Framework.Core"
               xmlns:nugetCommands="clr-namespace:ZYC.Framework.Modules.NuGet.Abstractions.Commands;assembly=ZYC.Framework.Modules.NuGet.Abstractions"
               xmlns:core="clr-namespace:ZYC.Framework.Core;assembly=ZYC.Framework.Core"
               xmlns:commands="clr-namespace:ZYC.Framework.Modules.ModuleManager.Commands"
               xmlns:abstractions="clr-namespace:ZYC.Framework.Modules.ModuleManager.Abstractions;assembly=ZYC.Framework.Modules.ModuleManager.Abstractions"
               mc:Ignorable="d"
               d:DesignHeight="450" d:DesignWidth="800"
               Title="{localizations:L NuGet Modules}"
               DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <page:PageBase.HeaderAdditionContent>
        <StackPanel HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
            <buttons:IconButton Text="{localizations:L Clear nuget http cache}"
                                Kind="DeleteOutline"
                                Margin="0 0 8 0"
                                Command="{markupEx:LifetimeScopeResolve nugetCommands:IClearNuGetHttpCacheCommand}" />
            <buttons:IconButton Text="Refresh"
                                Kind="Refresh"
                                Command="{markupEx:LifetimeScopeResolve commands:RefreshNuGetModuleCommand}"
                                CommandParameter="{Binding .}" />
        </StackPanel>
    </page:PageBase.HeaderAdditionContent>
    <Grid>
        <core:SplitView Visibility="{Binding ModulesCount,Converter={converters:IntToVisibilityConverter}}"
                        Ratio="{Binding Source={markupEx:LifetimeScopeResolve abstractions:NuGetModulePageState},Path=Ratio}">
            <core:SplitView.LeftContent>
                <Border Margin="0 8 0 0">
                    <ListBox BorderThickness="0"
                             ItemsSource="{Binding NuGetModules}"
                             SelectedItem="{Binding SelectedNuGetModule,Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>

                                    <core:HybridIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        Width="24"
                                        Height="24"
                                        FontSize="16"
                                        Icon="{Binding Icon}" />

                                    <StackPanel Grid.Column="1"
                                                Margin="8 0 0 0">
                                        <TextBlock FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding PackageId}" />
                                        <TextBlock Margin="0 4 0 0"
                                                   Opacity="0.72"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding Version}" />
                                        <TextBlock Margin="0 4 0 0"
                                                   Foreground="Green"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding InstalledStatusText}"
                                                   Visibility="{Binding Installed,Converter={converters:BoolToVisibilityConverter}}" />
                                        <TextBlock Margin="0 4 0 0"
                                                   Foreground="DarkOrange"
                                                   Text="Update available"
                                                   Visibility="{Binding HasAvailableUpdate,Converter={converters:BoolToVisibilityConverter}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </core:SplitView.LeftContent>
            <core:SplitView.RightContent>
                <Border
                    Margin="0 8 0 0"
                    Padding="16 16 0 16">
                    <Grid>
                        <ContentControl Content="{Binding SelectedNuGetModule}"
                                        Visibility="{Binding SelectedNuGetModule,Converter={converters:NullToVisibilityConverter}}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>

                                        <DockPanel Margin="0 0 0 16">
                                            <StackPanel DockPanel.Dock="Right"
                                                        Orientation="Horizontal"
                                                        Margin="16 0 0 0"
                                                        VerticalAlignment="Center">
                                                <buttons:IconButton Text="{Binding InstallActionText}"
                                                                    Kind="DownloadOutline"
                                                                    Command="{markupEx:LifetimeScopeResolve commands:InstallNuGetModuleCommand}"
                                                                    CommandParameter="{Binding .}" />
                                                <buttons:IconButton Text="Uninstall"
                                                                    Kind="DeleteOutline"
                                                                    Margin="8 0 0 0"
                                                                    Command="{markupEx:LifetimeScopeResolve commands:UninstallNuGetModuleCommand}"
                                                                    CommandParameter="{Binding .}" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal">
                                                <core:HybridIcon
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Top"
                                                    Width="32"
                                                    Height="32"
                                                    FontSize="20"
                                                    Icon="{Binding Icon}" />
                                                <StackPanel Margin="12 0 0 0">
                                                    <TextBlock FontSize="16"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               Text="{Binding PackageId}" />
                                                    <TextBlock Margin="0 4 0 0"
                                                               Opacity="0.72"
                                                               Text="{Binding InstalledStatusText}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DockPanel>

                                        <Separator Grid.Row="1" />

                                        <ScrollViewer Grid.Row="2"
                                                      Margin="0 16 0 0"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      VerticalScrollBarVisibility="Auto">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold"
                                                           Text="Package" />
                                                <TextBlock Margin="16 4 0 12">
                                                    <Run Text="PackageId" />
                                                    <Run Text=" : " />
                                                    <Run Text="{Binding PackageId,Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Margin="16 0 0 12">
                                                    <Run Text="Available Version" />
                                                    <Run Text=" : " />
                                                    <Run Text="{Binding Version,Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Margin="16 0 0 12">
                                                    <Run Text="Installed Version" />
                                                    <Run Text=" : " />
                                                    <Run Text="{Binding InstalledVersionText,Mode=OneWay}" />
                                                </TextBlock>

                                                <TextBlock Margin="0 8 0 4"
                                                           FontWeight="SemiBold"
                                                           Text="Description" />
                                                <TextBlock Margin="16 0 0 12"
                                                           TextWrapping="Wrap"
                                                           Text="{Binding Description}" />

                                                <TextBlock Margin="0 8 0 4"
                                                           FontWeight="SemiBold"
                                                           Text="Release Notes" />
                                                <TextBlock Margin="16 0 0 12"
                                                           TextWrapping="Wrap"
                                                           Text="{Binding PatchNote}" />
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Grid>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>

                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Opacity="0.72"
                                   Text="Select a NuGet module"
                                   Visibility="{Binding SelectedNuGetModule,Converter={converters:NullToVisibilityConverter Reverse=True}}" />
                    </Grid>
                </Border>

            </core:SplitView.RightContent>
        </core:SplitView>

        <page:NoItemView
            Visibility="{Binding ModulesCount,Converter={converters:IntToVisibilityConverter Reverse=True}}" />
    </Grid>
</page:PageBase>