<page:PageBase x:Class="ZYC.Framework.Modules.TextEditor.UI.TextPreviewView"
               x:ClassModifier="internal"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
               xmlns:page="clr-namespace:ZYC.Framework.Core.Page;assembly=ZYC.Framework.Core"
               xmlns:buttons="clr-namespace:ZYC.Framework.Core.Buttons;assembly=ZYC.Framework.Core"
               mc:Ignorable="d"
               d:DesignHeight="450"
               d:DesignWidth="800"
               Title="{Binding PageTitle}"
               DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <page:PageBase.HeaderAdditionContent>
        <Grid Margin="16 0 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0"
                        VerticalAlignment="Center"
                        Margin="0 0 16 0">
                <TextBlock Text="{Binding FilePathText}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding FilePathText}" />
                <TextBlock Text="{Binding SyncStatusText}"
                           FontSize="11"
                           Opacity="0.72" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <buttons:IconButton Click="OnReloadButtonClick"
                                    Kind="Reload"
                                    Margin="0 0 16 0"
                                    Text="Reload" />
                <buttons:IconButton Click="OnEditButtonClick"
                                    Kind="TextBoxEditOutline"
                                    Text="Edit"
                                    IsEnabled="{Binding IsFileAvailable}" />
            </StackPanel>
        </Grid>
    </page:PageBase.HeaderAdditionContent>
    <Grid Margin="0 8">
        <avalonEdit:TextEditor x:Name="Editor"
                               FontFamily="Consolas"
                               ShowLineNumbers="True"
                               IsReadOnly="True">
            <avalonEdit:TextEditor.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Copy"
                              Command="{x:Static ApplicationCommands.Copy}"
                              CommandTarget="{Binding PlacementTarget.TextArea, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <MenuItem Header="Select All"
                              Command="{x:Static ApplicationCommands.SelectAll}"
                              CommandTarget="{Binding PlacementTarget.TextArea, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                </ContextMenu>
            </avalonEdit:TextEditor.ContextMenu>
        </avalonEdit:TextEditor>
    </Grid>
</page:PageBase>