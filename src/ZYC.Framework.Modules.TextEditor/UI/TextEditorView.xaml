<page:PageBase x:Class="ZYC.Framework.Modules.TextEditor.UI.TextEditorView"
               x:ClassModifier="internal"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
               xmlns:page="clr-namespace:ZYC.Framework.Core.Page;assembly=ZYC.Framework.Core"
               xmlns:buttons="clr-namespace:ZYC.Framework.Core.Buttons;assembly=ZYC.Framework.Core"
               mc:Ignorable="d"
               d:DesignHeight="450"
               d:DesignWidth="800"
               Title="{Binding PageTitle}"
               DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <page:PageBase.HeaderAdditionContent>
        <Grid Margin="16 0 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0"
                        VerticalAlignment="Center"
                        Margin="0 0 16 0">
                <TextBlock Text="{Binding FilePathText}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding FilePathText}" />
                <TextBlock Text="{Binding StatusText}"
                           FontSize="11"
                           Opacity="0.72" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <buttons:IconButton
                    Kind="Reload"
                    Text="Reload"
                    Margin="0 0 16 0"
                    Click="OnReloadButtonClick">
                </buttons:IconButton>
                <buttons:IconButton Text="Save"
                    Kind="ContentSaveOutline"
                    Margin="0 0 16 0"
                    Click="OnSaveButtonClick">
                </buttons:IconButton>
                <buttons:IconButton Kind="ContentSaveMoveOutline"
                                    Text="Save As"
                                    Click="OnSaveAsButtonClick">
                </buttons:IconButton>
            </StackPanel>
        </Grid>
    </page:PageBase.HeaderAdditionContent>
    <Grid Margin="0 8">
        <avalonEdit:TextEditor x:Name="Editor"
                               FontFamily="Consolas"
                               ShowLineNumbers="True"
                               IsReadOnly="{Binding IsReadOnlyDocument}"
                               TextChanged="OnEditorTextChanged"
                               PreviewKeyDown="OnEditorPreviewKeyDown">
            <avalonEdit:TextEditor.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Reload"
                              Click="OnReloadMenuItemClick" />
                    <Separator />
                    <MenuItem Header="Save"
                              Click="OnSaveMenuItemClick" />
                    <MenuItem Header="Save As..."
                              Click="OnSaveAsMenuItemClick" />
                    <Separator />
                    <MenuItem Header="Cut"
                              Command="{x:Static ApplicationCommands.Cut}"
                              CommandTarget="{Binding PlacementTarget,RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <MenuItem Header="Copy"
                              Command="{x:Static ApplicationCommands.Copy}"
                              CommandTarget="{Binding PlacementTarget,RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <MenuItem Header="Paste"
                              Command="{x:Static ApplicationCommands.Paste}"
                              CommandTarget="{Binding PlacementTarget,RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <Separator />
                    <MenuItem Header="Select All"
                              Command="{x:Static ApplicationCommands.SelectAll}"
                              CommandTarget="{Binding PlacementTarget,RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                </ContextMenu>
            </avalonEdit:TextEditor.ContextMenu>
        </avalonEdit:TextEditor>
    </Grid>
</page:PageBase>