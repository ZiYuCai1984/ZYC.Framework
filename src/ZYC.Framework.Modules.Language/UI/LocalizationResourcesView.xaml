<page:PageBase x:Class="ZYC.Framework.Modules.Language.UI.LocalizationResourcesView"
               x:ClassModifier="internal"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:page="clr-namespace:ZYC.Framework.Core.Page;assembly=ZYC.Framework.Core"
               xmlns:converters="clr-namespace:ZYC.Framework.Core.Converters;assembly=ZYC.Framework.Core"
               xmlns:localizations="clr-namespace:ZYC.Framework.Core.Localizations;assembly=ZYC.Framework.Core"
               xmlns:core="clr-namespace:ZYC.Framework.Core;assembly=ZYC.Framework.Core"
               mc:Ignorable="d"
               d:DesignHeight="450"
               d:DesignWidth="800"
               Title="{localizations:L Localization Resources}"
               DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <page:PageBase.HeaderAdditionContent>
        <Grid Margin="16 0 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <ComboBox Width="160"
                      Height="24"
                      VerticalAlignment="Center"
                      ItemsSource="{Binding LanguageTypes}"
                      SelectedItem="{Binding LanguageType}" />
            <TextBox Grid.Column="1"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     Width="256"
                     Height="24"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center"
                     Style="{DynamicResource MahApps.Styles.TextBox.Search}" 
                     core:WatermarkBehavior.Watermark="{localizations:L Search localization}"/>
        </Grid>
    </page:PageBase.HeaderAdditionContent>
    <Grid Margin="0 8 0 0">
        <DataGrid ItemsSource="{Binding ResourceEntriesCollectionView}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{localizations:L Language}"
                                    Binding="{Binding LanguageDisplayName}"
                                    IsReadOnly="True"
                                    Width="Auto" />
                <DataGridTextColumn Header="{localizations:L Key}"
                                    Binding="{Binding Key}"
                                    IsReadOnly="True"
                                    Width="2*" />
                <DataGridTemplateColumn Header="{localizations:L Value}"
                                        Width="3*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="{Binding IsValueReadOnly}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     TextWrapping="Wrap"
                                     VerticalContentAlignment="Center"
                                     LostFocus="OnValueTextBoxLostFocus"
                                     KeyDown="OnValueTextBoxKeyDown" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{localizations:L Source}"
                                    Binding="{Binding SourceName}"
                                    IsReadOnly="True"
                                    Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>
        <page:NoItemView
            Visibility="{Binding CollectionViewCount,Converter={converters:IntToVisibilityConverter Reverse=True},FallbackValue=Collapsed}" />
    </Grid>
</page:PageBase>
