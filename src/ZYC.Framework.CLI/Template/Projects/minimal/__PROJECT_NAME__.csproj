<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
  </PropertyGroup>
  <PropertyGroup>
    <IgnoreFromPublish>true</IgnoreFromPublish>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ZYC.Framework.Alpha" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="ZYC.Framework.Abstractions">
      <HintPath>$(OutputPath)ZYC.Framework.Abstractions.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <None Update="ModuleConfig.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Link>../settings/ModuleConfig.json</Link>
    </None>
  </ItemGroup>
</Project>
