<page:PageBase x:Class="ZYC.Framework.Modules.ChromeExtensions.UI.ChromeExtensionManagerView"
               x:ClassModifier="internal"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:page="clr-namespace:ZYC.Framework.Core.Page;assembly=ZYC.Framework.Core"
               xmlns:core="clr-namespace:ZYC.Framework.Core;assembly=ZYC.Framework.Core"
               xmlns:buttons="clr-namespace:ZYC.Framework.Core.Buttons;assembly=ZYC.Framework.Core"
               xmlns:converters="clr-namespace:ZYC.Framework.Core.Converters;assembly=ZYC.Framework.Core"
               xmlns:markupEx="clr-namespace:ZYC.Framework.Core.MarkupEx;assembly=ZYC.Framework.Core"
               xmlns:commands="clr-namespace:ZYC.Framework.Core.Commands;assembly=ZYC.Framework.Core"
               mc:Ignorable="d"
               d:DesignHeight="640"
               d:DesignWidth="1120"
               Title="Chrome Extensions"
               DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <page:PageBase.HeaderAdditionContent>
        <StackPanel HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
            <buttons:IconButton Text="Chrome Web Store"
                                Kind="GoogleChrome"
                                IsEnabled="{Binding IsNotBusy}"
                                Click="OnOpenStoreButtonClick" />
        </StackPanel>
    </page:PageBase.HeaderAdditionContent>

    <Grid>
        <core:SplitView Visibility="{Binding InstalledExtensionsCount,Converter={converters:IntToVisibilityConverter}}"
                        Ratio="0.38"
                        MinLeftWidth="360"
                        MinRightWidth="420">
            <core:SplitView.LeftContent>
                <Border Margin="0 8 0 0">
                    <ListBox BorderThickness="0"
                             ItemsSource="{Binding InstalledExtensions}"
                             SelectedItem="{Binding SelectedInstalledExtension,Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>

                                    <core:HybridIcon HorizontalAlignment="Center"
                                                     VerticalAlignment="Top"
                                                     Width="24"
                                                     Height="24"
                                                     FontSize="16"
                                                     Icon="PuzzleOutline" />

                                    <StackPanel Grid.Column="1"
                                                Margin="8 0 0 0">
                                        <TextBlock FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding DisplayName}" />
                                        <TextBlock Margin="0 4 0 0"
                                                   Opacity="0.72"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding ExtensionId}" />
                                        <TextBlock Margin="0 4 0 0"
                                                   Opacity="0.72"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding UnpackedPath}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </core:SplitView.LeftContent>

            <core:SplitView.RightContent>
                <Border Margin="0 8 0 0"
                        Padding="16 16 0 16">
                    <Grid>
                        <ContentControl Content="{Binding SelectedInstalledExtension}"
                                        Visibility="{Binding SelectedInstalledExtension,Converter={converters:NullToVisibilityConverter}}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>

                                        <DockPanel Margin="0 0 0 16"
                                                   VerticalAlignment="Center">

                                            <StackPanel DockPanel.Dock="Right"
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal">
                                                <!-- ReSharper disable once Xaml.PossibleNullReferenceException -->
                                                <buttons:IconButton 
                                                    Text="Open Folder"
                                                    Kind="FolderOutline"
                                                    Margin="16 0 0 0"
                                                    Command="{markupEx:LifetimeScopeResolve commands:OpenFolderInExplorerCommand}"
                                                    CommandParameter="{Binding UnpackedPath}"/>
                                                <buttons:IconButton 
                                                    Text="Uninstall"
                                                    Kind="DeleteOutline"
                                                    Margin="16 0 0 0"
                                                    IsEnabled="{Binding CanUninstallSelectedExtension,RelativeSource={RelativeSource AncestorType=page:PageBase}}"
                                                    Click="OnUninstallButtonClick" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <core:HybridIcon HorizontalAlignment="Center"
                                                                 VerticalAlignment="Top"
                                                                 Width="32"
                                                                 Height="32"
                                                                 FontSize="20"
                                                                 Icon="PuzzleOutline" />
                                                <StackPanel Margin="12 0 0 0">
                                                    <TextBlock FontSize="16"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               Text="{Binding DisplayName}" />
                                                    <TextBlock Margin="0 4 0 0"
                                                               Foreground="Green"
                                                               Text="Installed" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DockPanel>

                                        <Separator Grid.Row="1" />

                                        <ScrollViewer Grid.Row="2"
                                                      Margin="0 16 0 0"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      VerticalScrollBarVisibility="Auto">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold"
                                                           Text="Extension" />
                                                <TextBlock Margin="16 4 0 12">
                                                    <Run Text="ID" />
                                                    <Run Text=" : " />
                                                    <Run Text="{Binding ExtensionId,Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Margin="16 0 0 12">
                                                    <Run Text="Version" />
                                                    <Run Text=" : " />
                                                    <Run Text="{Binding Version,Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Margin="16 0 0 12"
                                                           TextWrapping="Wrap">
                                                    <Run Text="Store" />
                                                    <Run Text=" : " />
                                                    <Run Text="{Binding StoreUrl,Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Margin="16 0 0 12"
                                                           TextWrapping="Wrap">
                                                    <Run Text="Download" />
                                                    <Run Text=" : " />
                                                    <Run Text="{Binding DownloadUrl,Mode=OneWay}" />
                                                </TextBlock>

                                                <TextBlock Margin="0 8 0 4"
                                                           FontWeight="SemiBold"
                                                           Text="Local Package" />
                                                <TextBlock Margin="16 0 0 12"
                                                           TextWrapping="Wrap">
                                                    <Run Text="Package" />
                                                    <Run Text=" : " />
                                                    <Run Text="{Binding PackagePath,Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Margin="16 0 0 12"
                                                           TextWrapping="Wrap">
                                                    <Run Text="Unpacked" />
                                                    <Run Text=" : " />
                                                    <Run Text="{Binding UnpackedPath,Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Margin="16 0 0 12">
                                                    <Run Text="Installed At" />
                                                    <Run Text=" : " />
                                                    <Run Text="{Binding InstalledAt,Mode=OneWay}" />
                                                </TextBlock>

                                                <TextBlock Margin="0 8 0 4"
                                                           FontWeight="SemiBold"
                                                           Text="Extension Pages" />
                                                <TextBlock Margin="16 0 0 12"
                                                           TextWrapping="Wrap">
                                                    <Run Text="Popup" />
                                                    <Run Text=" : " />
                                                    <Run Text="{Binding PopupPageUrl,Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Margin="16 0 0 12"
                                                           TextWrapping="Wrap">
                                                    <Run Text="Options" />
                                                    <Run Text=" : " />
                                                    <Run Text="{Binding OptionsPageUrl,Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Grid>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>

                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Opacity="0.72"
                                   Text="Select a local extension"
                                   Visibility="{Binding SelectedInstalledExtension,Converter={converters:NullToVisibilityConverter Reverse=True}}" />
                    </Grid>
                </Border>
            </core:SplitView.RightContent>
        </core:SplitView>

        <page:NoItemView
            Visibility="{Binding InstalledExtensionsCount,Converter={converters:IntToVisibilityConverter Reverse=True}}" />
    </Grid>
</page:PageBase>
