<core:DialogWindowBase x:Class="ZYC.Framework.Modules.WebBrowser.Dialog.ManagePluginsDialog"
                       x:ClassModifier="internal"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:buttons="clr-namespace:ZYC.Framework.Core.Buttons;assembly=ZYC.Framework.Core"
                       xmlns:converters="clr-namespace:ZYC.Framework.Core.Converters;assembly=ZYC.Framework.Core"
                       xmlns:core="clr-namespace:ZYC.Framework.Core;assembly=ZYC.Framework.Core"
                       mc:Ignorable="d"
                       d:DesignHeight="520"
                       d:DesignWidth="880"
                       Title="Manage Plugins"
                       Width="900"
                       Height="520"
                       ResizeMode="CanResizeWithGrip"
                       ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <DockPanel Margin="0 0 0 12"
                   LastChildFill="False">
            <TextBlock DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Text="{Binding SummaryText}" />

            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBox Width="260"
                         VerticalContentAlignment="Center"
                         Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}" />
                <buttons:IconButton Margin="8 0 0 0"
                                    Kind="Refresh"
                                    Text="Refresh"
                                    Click="OnRefreshButtonClick" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1"
                BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
                BorderThickness="1">
            <Grid>
                <ListView BorderThickness="0"
                          ItemsSource="{Binding PluginItems}"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasPluginItems,Converter={converters:BoolToVisibilityConverter}}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="200"
                                            Header="Name">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4"
                                                    Orientation="Horizontal">
                                            <core:HybridIcon Width="18"
                                                             Height="18"
                                                             Icon="GoogleChrome" />
                                            <TextBlock Margin="8 0 0 0"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding DisplayName}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="160"
                                            Header="ID">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ExtensionId}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="240"
                                            Header="Path">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding UnpackedPath}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="90"
                                            Header="State">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StateText}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="170"
                                            Header="Action">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="4">
                                            <buttons:IconButton Padding="6"
                                                                Kind="Plus"
                                                                Text="Add"
                                                                IsEnabled="{Binding CanAdd}"
                                                                Click="OnAddButtonClick" />
                                            <buttons:IconButton Margin="8 0 0 0"
                                                                Padding="6"
                                                                Kind="DeleteOutline"
                                                                Text="Remove"
                                                                IsEnabled="{Binding CanRemove}"
                                                                Click="OnRemoveButtonClick" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Opacity="0.72"
                           Text="No local extension packages"
                           Visibility="{Binding HasPluginItems,Converter={converters:BoolToVisibilityConverter Reverse=True}}" />
            </Grid>
        </Border>
    </Grid>
</core:DialogWindowBase>