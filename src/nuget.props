<Project>

  <PropertyGroup>
    <V_ZYC_CoreToolkit>4.0.5</V_ZYC_CoreToolkit>
  </PropertyGroup>

  <PropertyGroup>
    <!--!WARNING Referenced by <Sdk Name="Aspire.AppHost.Sdk" Version="$(V_Aspire)" />, so it cannot be placed in nuget.targets-->
    <V_Aspire>13.6.4</V_Aspire>
    <!-- !WARNING Keep compatible with Aspire's ModelContextProtocol dependency. -->
    <V_ModelContextProtocol>1.4.1</V_ModelContextProtocol>
  </PropertyGroup>


  <PropertyGroup>
    <V_ZYC_CoreToolkit_Extensions_Fxc>3.8.4</V_ZYC_CoreToolkit_Extensions_Fxc>
  </PropertyGroup>

  <PropertyGroup>
    <Package_Root_Directory_ZYC_Framework>$(MSBuildThisFileDirectory)../</Package_Root_Directory_ZYC_Framework>
  </PropertyGroup>

</Project>