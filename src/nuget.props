<Project>

  <PropertyGroup>
    <V_ZYC_CoreToolkit>3.9.6</V_ZYC_CoreToolkit>
  </PropertyGroup>

  <!--!WARNING Referenced by <Sdk Name="Aspire.AppHost.Sdk" Version="$(V_Aspire)" />, so it cannot be placed in nuget.targets-->
  <PropertyGroup>
    <V_Aspire>13.4.6</V_Aspire>
  </PropertyGroup>

  <PropertyGroup>
    <V_ZYC_CoreToolkit_Extensions_Fxc>3.8.4</V_ZYC_CoreToolkit_Extensions_Fxc>
  </PropertyGroup>

  <PropertyGroup>
    <Package_Root_Directory_ZYC_Framework>$(MSBuildThisFileDirectory)../</Package_Root_Directory_ZYC_Framework>
  </PropertyGroup>

</Project>