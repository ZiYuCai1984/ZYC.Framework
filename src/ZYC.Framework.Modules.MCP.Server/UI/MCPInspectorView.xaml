<page:PageBase x:Class="ZYC.Framework.Modules.MCP.Server.UI.MCPInspectorView"
               x:ClassModifier="internal"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:page="clr-namespace:ZYC.Framework.Core.Page;assembly=ZYC.Framework.Core"
               xmlns:core="clr-namespace:ZYC.Framework.Core;assembly=ZYC.Framework.Core"
               xmlns:buttons="clr-namespace:ZYC.Framework.Core.Buttons;assembly=ZYC.Framework.Core"
               xmlns:converters="clr-namespace:ZYC.Framework.Core.Converters;assembly=ZYC.Framework.Core"
               xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
               mc:Ignorable="d"
               d:DesignHeight="640"
               d:DesignWidth="1120"
               Title="MCP Inspector"
               DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <page:PageBase.HeaderAdditionContent>
        <StackPanel HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Text="{Binding StatusText}" />
            <TextBox Margin="12 0 0 0"
                     MinWidth="180"
                     VerticalAlignment="Center"
                     IsReadOnly="True"
                     Text="{Binding Endpoint,Mode=OneWay}" />
            <buttons:IconButton Margin="8 0 0 0"
                                Text="Copy"
                                Kind="ContentCopy"
                                Click="OnCopyEndpointButtonClick" />
            <buttons:IconButton Margin="8 0 0 0"
                                Text="Start"
                                Kind="PlayCircleOutline"
                                IsEnabled="{Binding CanStart}"
                                Click="OnStartButtonClick" />
            <buttons:IconButton Margin="8 0 0 0"
                                Text="Stop"
                                Kind="PauseCircleOutline"
                                IsEnabled="{Binding CanStop}"
                                Click="OnStopButtonClick" />
            <buttons:IconButton Margin="8 0 0 0"
                                Text="Refresh"
                                Kind="Refresh"
                                IsEnabled="{Binding CanRefresh}"
                                Click="OnRefreshButtonClick" />
        </StackPanel>
    </page:PageBase.HeaderAdditionContent>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <TextBlock Margin="0 8 0 0"
                   Foreground="Red"
                   TextWrapping="Wrap"
                   Text="{Binding LastError}"
                   Visibility="{Binding LastError,Converter={converters:NullToVisibilityConverter}}" />

        <core:SplitView Grid.Row="1"
                        Ratio="0.32"
                        MinLeftWidth="280"
                        MinRightWidth="420"
                        Visibility="{Binding IsRunning,Converter={converters:BoolToVisibilityConverter}}">
            <core:SplitView.LeftContent>
                <DockPanel Margin="0 8 8 0">
                    <TextBox DockPanel.Dock="Top"
                             Margin="0 0 0 8"
                             mah:TextBoxHelper.Watermark="Search tools"
                             mah:TextBoxHelper.ClearTextButton="True"
                             Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock DockPanel.Dock="Bottom"
                               Margin="0 8 0 8"
                               Opacity="0.72"
                               Text="{Binding ToolsSummary}" />
                    <ListBox BorderThickness="0"
                             ItemsSource="{Binding ToolsView}"
                             SelectedItem="{Binding SelectedTool,Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="4 12 0 4"
                                                   FontWeight="SemiBold"
                                                   Opacity="0.72"
                                                   Text="{Binding Name}" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="8 4">
                                    <TextBlock FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding ShortName}" />
                                    <TextBlock Margin="0 2 0 0"
                                               Opacity="0.72"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding Description}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </core:SplitView.LeftContent>

            <core:SplitView.RightContent>
                <Grid Margin="16 8 0 16">
                    <Grid Visibility="{Binding SelectedTool,Converter={converters:NullToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="80" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="2*" MinHeight="120" />
                        </Grid.RowDefinitions>

                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding SelectedTool.Name}" />

                        <TextBlock Grid.Row="1"
                                   Margin="0 8 0 0"
                                   TextWrapping="Wrap"
                                   Opacity="0.85"
                                   Text="{Binding SelectedTool.Description}" />

                        <Expander Grid.Row="2"
                                  Margin="0 12 0 0"
                                  Header="Input Schema"
                                  IsExpanded="False">
                            <TextBox MaxHeight="240"
                                     FontFamily="Consolas"
                                     IsReadOnly="True"
                                     TextWrapping="NoWrap"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding SelectedTool.InputSchemaText,Mode=OneWay}" />
                        </Expander>

                        <DockPanel Grid.Row="3"
                                   Margin="0 12 0 4">
                            <buttons:IconButton DockPanel.Dock="Right"
                                                Text="Reset"
                                                Kind="Restore"
                                                Click="OnResetArgumentsButtonClick" />
                            <TextBlock VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="Arguments (JSON)" />
                        </DockPanel>

                        <TextBox Grid.Row="4"
                                 FontFamily="Consolas"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 TextWrapping="NoWrap"
                                 VerticalContentAlignment="Top"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding ArgumentsText,UpdateSourceTrigger=PropertyChanged}" />

                        <DockPanel Grid.Row="5"
                                   Margin="0 8 0 8">
                            <buttons:IconButton DockPanel.Dock="Left"
                                                Text="Execute"
                                                Kind="Play"
                                                IsEnabled="{Binding CanExecuteTool}"
                                                Click="OnExecuteButtonClick" />
                            <CheckBox DockPanel.Dock="Right"
                                      VerticalAlignment="Center"
                                      Content="Raw JSON"
                                      IsChecked="{Binding ShowRawResult}" />
                            <TextBlock Margin="12 0 0 0"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="{Binding ResultSummary}" />
                        </DockPanel>

                        <TextBox Grid.Row="6"
                                 FontFamily="Consolas"
                                 IsReadOnly="True"
                                 TextWrapping="NoWrap"
                                 VerticalContentAlignment="Top"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding ResultText,Mode=OneWay}" />
                    </Grid>

                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Opacity="0.72"
                               Text="Select a tool"
                               Visibility="{Binding SelectedTool,Converter={converters:NullToVisibilityConverter Reverse=True}}" />
                </Grid>
            </core:SplitView.RightContent>
        </core:SplitView>

        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsRunning,Converter={converters:BoolToVisibilityConverter Reverse=True}}">
            <TextBlock HorizontalAlignment="Center"
                       Opacity="0.72"
                       Text="MCP server is not running." />
            <buttons:IconButton Margin="0 12 0 0"
                                HorizontalAlignment="Center"
                                Text="Start Server"
                                Kind="PlayCircleOutline"
                                IsEnabled="{Binding CanStart}"
                                Click="OnStartButtonClick" />
        </StackPanel>
    </Grid>
</page:PageBase>