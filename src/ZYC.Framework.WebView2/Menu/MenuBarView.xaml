<UserControl x:Class="ZYC.Framework.WebView2.Menu.MenuBarView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:markupEx="clr-namespace:ZYC.Framework.Core.MarkupEx;assembly=ZYC.Framework.Core"
             xmlns:localizations="clr-namespace:ZYC.Framework.Core.Localizations;assembly=ZYC.Framework.Core"
             xmlns:buttons="clr-namespace:ZYC.Framework.Core.Buttons;assembly=ZYC.Framework.Core"
             xmlns:commands="clr-namespace:ZYC.Framework.Core.Commands;assembly=ZYC.Framework.Core"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:converters="clr-namespace:ZYC.Framework.Core.Converters;assembly=ZYC.Framework.Core"
             xmlns:menu="clr-namespace:ZYC.Framework.WebView2.Menu"
             xmlns:localCommands="clr-namespace:ZYC.Framework.WebView2.Commands"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:localConverters="clr-namespace:ZYC.Framework.WebView2.Converters"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Height="32"
             Visibility="{Binding IsMenuBarVisible,Converter={converters:BoolToVisibilityConverter}}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ItemsControl>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <Button Command="{Binding GoBackCommand}"
                    Visibility="{Binding GoBackCommand,Converter={converters:NullToVisibilityConverter}}">
                <iconPacks:PackIconMaterial Kind="ArrowLeft"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Width="16"
                                            Height="16"
                                            BorderThickness="0" />
            </Button>
            <Button Command="{Binding GoForwardCommand}"
                    Visibility="{Binding GoForwardCommand,Converter={converters:NullToVisibilityConverter}}">
                <iconPacks:PackIconMaterial Kind="ArrowRight"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Width="16"
                                            Height="16"
                                            BorderThickness="0" />
            </Button>
            <Button Command="{Binding HomePageCommand}"
                    Visibility="{Binding HomePageCommand,Converter={converters:NullToVisibilityConverter}}">
                <iconPacks:PackIconMaterial Kind="HomeOutline"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Width="16"
                                            Height="16"
                                            BorderThickness="0" />
            </Button>
            <Button Command="{Binding RefreshCommand}"
                    Visibility="{Binding RefreshCommand,Converter={converters:NullToVisibilityConverter}}">
                <iconPacks:PackIconMaterial Kind="Refresh"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Width="16"
                                            Height="16"
                                            BorderThickness="0" />
            </Button>

        </ItemsControl>

        <!-- ReSharper disable Xaml.BindingWithContextNotResolved -->
        <TextBox
            Grid.Column="1"
            IsReadOnly="True"
            Text="{Binding WebView2.Source,Converter={converters:NullToEmptyStringConverter},Mode=OneWay}"
            VerticalContentAlignment="Center"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch" />

        <ItemsControl Grid.Column="2">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <mah:SplitButton
                BorderThickness="1"
                Padding="0"
                VerticalContentAlignment="Center"
                BorderBrush="{StaticResource MahApps.Brushes.Gray6}"
                Background="{StaticResource MahApps.Brushes.Gray10}"
                Command="{markupEx:LifetimeScopeResolve localCommands:ShowPluginsDialogViewCommand}"
                CommandParameter="{Binding CoreWebView2BrowserExtensions}">
                <mah:SplitButton.Icon>
                    <DockPanel>
                        <iconPacks:PackIconMaterial Kind="PuzzleOutline" 
                                                    Height="16"
                                                    Width="16"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    DockPanel.Dock="Left"
                                                    Margin="8 0 8 0"/>
                        <TextBlock FontSize="10"
                                   VerticalAlignment="Center"
                                   FontWeight="Black"
                                   Text="{Binding CoreWebView2BrowserExtensions,Converter={localConverters:PluginsButtonTextConverter}}">
                        </TextBlock>
                    </DockPanel>
                </mah:SplitButton.Icon>
            </mah:SplitButton>
            <buttons:IconButton
                Command="{markupEx:LifetimeScopeResolve commands:CopyAndNotifyCommand}"
                CommandParameter="{Binding WebView2.Source}"
                Text="{localizations:L Copy}"
                Kind="ContentCopy" />
            <buttons:IconButton Kind="ApplicationBracketsOutline"
                                Text="{localizations:L Dev tools}"
                                Command="{Binding OpenDevToolsWindowCommand}"
                                CommandParameter="{Binding .}" />
        </ItemsControl>

        <!--!WARNING Design defeat !!It's using MenuBarView's DataContext here.-->
        <Grid Grid.Column="3"
              DataContext="{Binding RelativeSource={RelativeSource FindAncestor,AncestorType=menu:MenuBarView}}">
            <ItemsControl ItemsSource="{Binding ExtendedMenuItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <buttons:IconButton
                            Command="{Binding Command}"
                            Kind="{Binding Icon}">
                            <buttons:IconButton.Text>
                                <MultiBinding Converter="{converters:LocalizationMultiConverter}">
                                    <Binding Path="Title" />
                                    <Binding Path="Localization" />
                                </MultiBinding>
                            </buttons:IconButton.Text>
                        </buttons:IconButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</UserControl>