<core:DialogWindowBase x:Class="ZYC.Framework.WebView2.Dialog.PluginsDialogView"
                       x:ClassModifier="internal"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:buttons="clr-namespace:ZYC.Framework.Core.Buttons;assembly=ZYC.Framework.Core"
                       xmlns:converters="clr-namespace:ZYC.Framework.Core.Converters;assembly=ZYC.Framework.Core"
                       xmlns:core="clr-namespace:ZYC.Framework.Core;assembly=ZYC.Framework.Core"
                       xmlns:localizations="clr-namespace:ZYC.Framework.Core.Localizations;assembly=ZYC.Framework.Core"
                       mc:Ignorable="d"
                       d:DesignHeight="420"
                       d:DesignWidth="720"
                       Title="{localizations:L Plugins}"
                       Width="720"
                       Height="420"
                       MinWidth="560"
                       MinHeight="320"
                       ResizeMode="CanResizeWithGrip"
                       ShowInTaskbar="False"
                       DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <TextBlock Margin="0 0 0 12"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Text="{Binding PluginSummary}" />

        <Border Grid.Row="1"
                BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
                BorderThickness="1">
            <Grid>
                <ListView BorderThickness="0"
                          ItemsSource="{Binding CoreWebView2BrowserExtensions}"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding PluginInfoCount,Converter={converters:IntToVisibilityConverter}}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="220"
                                            Header="{localizations:L Name}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="360"
                                            Header="ID">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Id}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="96"
                                            Header="{localizations:L Enabled}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center"
                                                  IsChecked="{Binding IsEnabled,Mode=OneWay}"
                                                  IsEnabled="False" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Opacity="0.72"
                           Text="{localizations:L No plugins}"
                           Visibility="{Binding PluginInfoCount,Converter={converters:IntToVisibilityConverter Reverse=True}}" />
            </Grid>
        </Border>
    </Grid>
</core:DialogWindowBase>
