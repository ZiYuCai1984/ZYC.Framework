<UserControl x:Class="ZYC.Framework.Modules.Mock.UI.TestMarkdownView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mdxaml="clr-namespace:ZYC.MdXaml;assembly=ZYC.MdXaml"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="MockResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <Button Click="OnResetSampleBtnClick"
                    Content="Reset Sample" />
            <Button Click="OnRenderBtnClick"
                    Content="Re-render" />
            <CheckBox x:Name="DisabledLazyLoadCheckBox"
                      Content="DisabledLazyLoad (sync images)"
                      Margin="8,0,0,0"
                      VerticalAlignment="Center"
                      Checked="OnDisabledLazyLoadChanged"
                      Unchecked="OnDisabledLazyLoadChanged" />
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SourceTextBox"
                     Grid.Column="0"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     FontFamily="Consolas"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     TextChanged="OnSourceTextChanged" />
            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" />
            <mdxaml:MarkdownScrollViewer x:Name="MarkdownViewer"
                                         Grid.Column="2"
                                         ClickAction="SafetyOpenBrowser"
                                         VerticalScrollBarVisibility="Auto" />
        </Grid>
    </DockPanel>
</UserControl>
