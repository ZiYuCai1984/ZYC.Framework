<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:markup="clr-namespace:ZYC.Framework.Core.MarkupEx;assembly=ZYC.Framework.Core"
                    xmlns:search="clr-namespace:WpfHexEditor.HexEditor.Search.Views;assembly=WpfHexEditor.HexEditor">
    <!-- WPFHexaEditor expects its IDE's theme keys. Keep the compatibility resources
         in the search window styles so generic keys do not affect other modules. -->
    <Style x:Key="HexEditor.SearchDialogStyle" TargetType="{x:Type Window}">
        <Style.Resources>
            <SolidColorBrush x:Key="DockBackgroundBrush"
                             Color="{DynamicResource MahApps.Colors.ThemeBackground}" />
            <SolidColorBrush x:Key="DockWindowBackgroundBrush"
                             Color="{DynamicResource MahApps.Colors.ThemeBackground}" />
            <SolidColorBrush x:Key="DockMenuBackgroundBrush"
                             Color="{DynamicResource MahApps.Colors.Gray10}" />
            <SolidColorBrush x:Key="DockMenuForegroundBrush"
                             Color="{DynamicResource MahApps.Colors.ThemeForeground}" />
            <SolidColorBrush x:Key="DockBorderBrush"
                             Color="{DynamicResource MahApps.Colors.Gray6}" />
            <SolidColorBrush x:Key="DockTabHoverBrush"
                             Color="{DynamicResource MahApps.Colors.Gray8}" />
            <SolidColorBrush x:Key="DockTabActiveBrush"
                             Color="{DynamicResource MahApps.Colors.Gray7}" />
            <SolidColorBrush x:Key="AccentBrush"
                             Color="{DynamicResource MahApps.Colors.AccentBase}" />
            <SolidColorBrush x:Key="Panel_ToolbarBrush"
                             Color="{DynamicResource MahApps.Colors.Gray10}" />

            <!-- The legacy Find/Replace dialog uses these names instead of Dock*. -->
            <!-- Use the same keyed-resource extension as the host theme. -->
            <markup:StaticResource x:Key="BackgroundBrush" ResourceKey="DockBackgroundBrush" />
            <markup:StaticResource x:Key="ForegroundBrush" ResourceKey="DockMenuForegroundBrush" />
            <markup:StaticResource x:Key="BackgroundColor" ResourceKey="MahApps.Colors.ThemeBackground" />
            <markup:StaticResource x:Key="AccentColor" ResourceKey="MahApps.Colors.AccentBase" />

            <Style x:Key="DockComboBoxStyle"
                   TargetType="{x:Type ComboBox}"
                   BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="Foreground" Value="{DynamicResource DockMenuForegroundBrush}" />
            </Style>
            <Style x:Key="DockCheckBoxStyle"
                   TargetType="{x:Type CheckBox}"
                   BasedOn="{StaticResource {x:Type CheckBox}}">
                <Setter Property="Foreground" Value="{DynamicResource DockMenuForegroundBrush}" />
            </Style>

            <Style x:Key="TitleBarButtonStyle" TargetType="{x:Type Button}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource DockMenuForegroundBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource DockTabHoverBrush}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource DockTabActiveBrush}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.5" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="TitleBarCloseButtonStyle"
                   TargetType="{x:Type Button}"
                   BasedOn="{StaticResource TitleBarButtonStyle}">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#E81123" />
                        <Setter Property="Foreground" Value="White" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="#C50F1F" />
                        <Setter Property="Foreground" Value="White" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Style.Resources>
        <Setter Property="Background" Value="{DynamicResource DockBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DockMenuForegroundBrush}" />
    </Style>

    <Style TargetType="{x:Type search:AdvancedSearchDialog}"
           BasedOn="{StaticResource HexEditor.SearchDialogStyle}" />
    <Style TargetType="{x:Type search:FindReplaceDialog}"
           BasedOn="{StaticResource HexEditor.SearchDialogStyle}" />
    <Style TargetType="{x:Type search:RelativeSearchDialog}"
           BasedOn="{StaticResource HexEditor.SearchDialogStyle}" />
</ResourceDictionary>
