<page:PageBase x:Class="ZYC.Framework.Modules.HexEditor.UI.HexEditorView"
               x:ClassModifier="internal"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:hex="clr-namespace:WpfHexEditor.HexEditor;assembly=WpfHexEditor.HexEditor"
               xmlns:page="clr-namespace:ZYC.Framework.Core.Page;assembly=ZYC.Framework.Core"
               xmlns:buttons="clr-namespace:ZYC.Framework.Core.Buttons;assembly=ZYC.Framework.Core"
               mc:Ignorable="d"
               d:DesignHeight="450"
               d:DesignWidth="800"
               PreviewKeyDown="OnEditorPreviewKeyDown"
               DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <page:PageBase.HeaderAdditionContent>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0"
                        VerticalAlignment="Center"
                        Margin="0 0 16 0">
                <TextBlock Text="{Binding FilePathText}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding FilePathText}" />
                <TextBlock Text="{Binding StatusText}"
                           FontSize="11"
                           Opacity="0.72" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <buttons:IconButton Kind="Reload"
                                    Text="Reload"
                                    IsEnabled="{Binding IsIdle}"
                                    Margin="0 0 16 0"
                                    Click="OnReloadButtonClick" />
                <buttons:IconButton Kind="ContentSaveOutline"
                                    Text="Save"
                                    ToolTip="Save (Ctrl+S)"
                                    IsEnabled="{Binding CanSave}"
                                    Margin="0 0 16 0"
                                    Click="OnSaveButtonClick" />
                <buttons:IconButton Kind="ContentSaveMoveOutline"
                                    Text="Save As"
                                    ToolTip="Save As (Ctrl+Shift+S)"
                                    IsEnabled="{Binding CanSave}"
                                    Click="OnSaveAsButtonClick" />
            </StackPanel>
        </Grid>
    </page:PageBase.HeaderAdditionContent>
    <Grid>
        <hex:HexEditor x:Name="Editor"
                       FontFamily="Consolas"
                       IsEnabled="{Binding CanSave}"
                       AllowFileDrop="False"
                       ShowHeader="True"
                       ShowOffset="True"
                       ShowAscii="True"
                       ShowStatusBar="True" 
                       ShowBreadcrumbBar="False"/>
    </Grid>
</page:PageBase>
