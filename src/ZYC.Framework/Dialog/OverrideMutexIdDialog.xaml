<core:DialogWindowBase x:Class="ZYC.Framework.Dialog.OverrideMutexIdDialog"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:core="clr-namespace:ZYC.Framework.Core;assembly=ZYC.Framework.Core"
                       xmlns:buttons="clr-namespace:ZYC.Framework.Core.Buttons;assembly=ZYC.Framework.Core"
                       xmlns:markupEx="clr-namespace:ZYC.Framework.Core.MarkupEx;assembly=ZYC.Framework.Core"
                       xmlns:commands="clr-namespace:ZYC.Framework.Commands"
                       xmlns:localizations="clr-namespace:ZYC.Framework.Core.Localizations;assembly=ZYC.Framework.Core"
                       mc:Ignorable="d"
                       d:DesignHeight="180" d:DesignWidth="420"
                       Title="{localizations:L Override Mutex Id}"
                       SizeToContent="WidthAndHeight"
                       ResizeMode="NoResize"
                       ShowInTaskbar="False"
                       Loaded="OnDialogLoaded"
                       DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <StackPanel Margin="16">
        <TextBlock Text="{localizations:L Mutex override}"
                   Margin="0 0 0 8" />

        <TextBox x:Name="MutexOverrideIdTextBox"
                 Width="360"
                 Text="{Binding MutexOverrideId, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0 0 0 12" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <buttons:IconButton Margin="0 0 8 0"
                                Kind="Delete"
                                Text="{localizations:L Delete mutex-override}"
                                Command="{markupEx:LifetimeScopeResolve commands:DeleteMutexOverrideIdCommand}" />
            <buttons:IconButton Kind="Check"
                                Text="{localizations:L Save}"
                                Command="{markupEx:LifetimeScopeResolve commands:SaveMutexOverrideIdCommand}"
                                CommandParameter="{Binding MutexOverrideId}" />
        </StackPanel>
    </StackPanel>
</core:DialogWindowBase>