<core:DialogWindowBase x:Class="ZYC.Framework.Workspace.CustomLayouts.ManageCustomLayoutsDialog"
                       x:ClassModifier="internal"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:core="clr-namespace:ZYC.Framework.Core;assembly=ZYC.Framework.Core"
                       xmlns:converters="clr-namespace:ZYC.Framework.Core.Converters;assembly=ZYC.Framework.Core"
                       xmlns:localizations="clr-namespace:ZYC.Framework.Core.Localizations;assembly=ZYC.Framework.Core"
                       xmlns:buttons="clr-namespace:ZYC.Framework.Core.Buttons;assembly=ZYC.Framework.Core"
                       mc:Ignorable="d"
                       d:DesignHeight="440" d:DesignWidth="680"
                       Title="{localizations:L Manage Custom Layouts}"
                       Width="680"
                       Height="440"
                       MinWidth="620"
                       MinHeight="380"
                       ResizeMode="CanResizeWithGrip"
                       ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="180" />
        </Grid.ColumnDefinitions>

        <Border BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
                BorderThickness="1">
            <Grid>
                <ListBox x:Name="LayoutsListBox"
                         BorderThickness="0"
                         ItemsSource="{Binding LayoutItems}"
                         SelectedItem="{Binding SelectedLayout, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="106" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Width="96"
                                        Height="64"
                                        BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
                                        BorderThickness="1"
                                        Background="{DynamicResource MahApps.Brushes.ThemeBackground}">
                                    <core:HybridIcon Width="96"
                                                     Height="64"
                                                     Icon="{Binding Thumbnail}" />
                                </Border>

                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding Name}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Opacity="0.72"
                           Text="{localizations:L No custom layouts}"
                           Visibility="{Binding HasLayouts, Converter={converters:BoolToVisibilityConverter Reverse=True}}" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="0"
                    Grid.Column="2">
            <TextBlock Text="Name"
                       Margin="0,0,0,6" />
            <TextBox x:Name="EditNameTextBox"
                     Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />

            <buttons:IconButton Kind="Pencil"
                                Text="{localizations:L Rename}"
                                x:Name="RenameButton"
                                Margin="0,12,0,0"
                                Click="OnRenameButtonClick" />

            <buttons:IconButton x:Name="DeleteButton"
                                Margin="0,8,0,0"
                                Click="OnDeleteButtonClick"
                                Kind="Delete"
                                Text="{localizations:L Delete}" />

            <Separator Margin="0,14,0,14" />

            <buttons:IconButton x:Name="MoveUpButton"
                                Click="OnMoveUpButtonClick"
                                Kind="ArrowUp"
                                Text="{localizations:L Move Up}" />

            <buttons:IconButton x:Name="MoveDownButton"
                                Margin="0,8,0,0"
                                Click="OnMoveDownButtonClick"
                                Kind="ArrowDown"
                                Text="{localizations:L Move Down}" />
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <buttons:IconButton MinWidth="80"
                                Kind="Close"
                                Click="OnCloseButtonClick"
                                Text="{localizations:L Close}" />
        </StackPanel>
    </Grid>
</core:DialogWindowBase>